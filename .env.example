# Buat secret:  openssl rand -hex 32

# --- Rahasia bersama core dan auth ---
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32
INTERNAL_TOKEN=ganti-dengan-hasil-openssl-rand-hex-16

# --- Akun admin awal (dibuat otomatis saat auth start) ---
ADMIN_EMAIL=admin@jelajahlokal.test
ADMIN_PASSWORD=ganti-password-admin

# --- Data uji untuk demo dan untuk kelompok lain (set false setelah penilaian bila perlu) ---
SEED_DEMO=true
DEMO_PASSWORD=demo123
SEED_API_KEY=jl_ganti-dengan-hasil-openssl-rand-hex-16

# --- Port gateway di STB (vhost nginx aaPanel meneruskan /api/ ke 127.0.0.1:8080) ---
GATEWAY_PORT=8080

# --- Opsional: ambang wisata tersembunyi (kurang dari N ulasan) ---
HIDDEN_MAX_REVIEWS=5

# --- Opsional: sumber status risiko wilayah (kosong = fitur risiko menampilkan pesan) ---
RISK_API_URL=
RISK_API_KEY=
RISK_API_KEY_HEADER=X-API-Key
RISK_LAT_PARAM=lat
RISK_LON_PARAM=lon
# Nama field tingkat risiko di respons JSON; titik untuk bersarang, contoh: data.status
RISK_LEVEL_FIELD=data.risk_level

# --- Smart City (KotaSiaga): sumber cuaca dan risiko ---
# Isi setelah API Registry terbit, contoh: https://kotasiaga.stei.<fun|site>/api
SMARTCITY_API_URL=
# API key dari grup Smart City. Isi hanya di .env, jangan di sini.
SMARTCITY_API_KEY=

# --- Mock mode untuk demo ---
MOCK_MODE=false
MOCK_UPSTREAM_SMARTCITY=false
# Kunci admin untuk POST /_mock/scenario dan GET /_mock/state (header X-API-Key). Isi hanya di .env.
MOCK_ADMIN_API_KEY=
MOCK_TICK_SECONDS=5
# MOCK_SEED=123   # isi untuk hasil yang dapat diulang; seed selalu dicatat di log saat start